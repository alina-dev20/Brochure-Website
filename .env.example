# Скопируйте этот файл в .env.local и заполните. .env.local не попадает в git.

# --- Обязательно: заявки в Telegram-группу ---
# Токен бота от @BotFather (см. README, раздел «Заявки»)
TELEGRAM_BOT_TOKEN=
# ID закрытой группы с менеджерами (начинается с -100…)
TELEGRAM_CHAT_ID=

# --- Необязательно ---
# Архив заявок в Google Таблице: URL веб-приложения Apps Script (см. README)
SHEETS_WEBHOOK_URL=
# Адрес продакшена (для метатегов, sitemap, Schema.org)
NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru
# Номер счётчика Яндекс.Метрики (цели: lead_submit, messenger_click)
NEXT_PUBLIC_YM_ID=
